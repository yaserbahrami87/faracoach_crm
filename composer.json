{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.3",
        "alexusmai/laravel-file-manager": "2.5.4",
        "anetwork/validation": "^2.2",
        "barryvdh/laravel-elfinder": "^0.4.6",
        "doctrine/dbal": "^2.4",
        "econea/nusoap": "dev-master",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "haruncpi/laravel-user-activity": "^1.0",
        "hekmatinasser/verta": "^1.11",
        "intervention/image": "^2.7",
        "irazasyed/telegram-bot-sdk": "^3.9",
        "jorenvanhocht/laravel-share": "^4.1",
        "kavenegar/laravel": "^1.3",
        "laravel-lang/lang": "~7.0",
        "laravel/framework": "^8.0",
        "laravel/tinker": "^2.0",
        "laravel/ui": "3.0",
        "livewire/livewire": "^2.12",
        "mpdf/mpdf": "^8.1",
        "niklasravnsborg/laravel-pdf": "^4.1",
        "nwidart/laravel-modules": "^8.3",
        "rap2hpoutre/fast-excel": "^2.3",
        "shetabit/payment": "^4.0",
        "shetabit/visitor": "^3.1",
        "uxweb/sweet-alert": "^2.0"
    },
    "require-dev": {
        "facade/ignition": "^2.3.6",
        "fzaninotto/faker": "^1.9.1",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^5.5",
        "phpunit/phpunit": "^9.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
